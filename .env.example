# ==============================================================================
# Django Database Configuration — PostgreSQL (Production)
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# By default, the project uses PostgreSQL. Set DB_ENGINE=sqlite for local dev
# without a PostgreSQL server.

# ---------- Engine ----------
# Options: postgresql | sqlite | mysql
DB_ENGINE=postgresql

# ---------- Connection ----------
DB_NAME=employee_truck_control
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=5432

# ---------- Persistent Connections ----------
# How long (in seconds) to keep database connections open.
# 600 = 10 minutes. Reduces connection overhead for frequent requests.
CONN_MAX_AGE=600

# ---------- SSL Configuration ----------
# Set to "disable" if connecting locally without SSL.
# Common values: require | verify-ca | verify-full
DB_SSL_MODE=require
# Paths to SSL certificate files (optional, only needed for mutual TLS):
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem
# DB_SSL_ROOT_CERT=/path/to/ca-cert.pem

# ---------- Connection Pooling (Optional) ----------
# Set DB_POOL_ENABLED=True to use django-db-connection-pool with SQLAlchemy.
# Install required package: pip install django-db-connection-pool
DB_POOL_ENABLED=False
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=600

# ==============================================================================
# Django Core Settings
# ==============================================================================
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1 localhost naelsilva.pythonanywhere.com

# ==============================================================================
# Email (password recovery and account email verification)
# ==============================================================================
# In DEBUG=True, emails are printed to the console by default even if these
# are left unset. Set them to send real emails (e.g. via Gmail SMTP with an
# App Password, or another provider like SendGrid/Mailgun).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com